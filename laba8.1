n = int(input("Введите количество чисел N: "))
# ввод самих чисел
numbers = []
for i in range(n):
    x = int(input(f"Введите число {i + 1}: "))
    numbers.append(x)
# подсчёт чисел, встречающихся ровно один раз
count = 0
for num in numbers:
    if numbers.count(num) == 1:
        count += 1
print(f"Количество чисел, встречающихся по одному разу: {count}")
