n = int(input("Введите порядок массива n: "))
# ввод двумерного массива
print("Введите элементы массива построчно (по", n, "чисел в строке):")
matrix = []
for i in range(n):
    row = list(map(int, input(f"Строка {i + 1}: ").split()))
    while len(row) != n:
        print(f"Ошибка: нужно ввести ровно {n} чисел. Попробуйте снова.")
        row = list(map(int, input(f"Строка {i + 1}: ").split()))
    matrix.append(row)
# эталонный набор чисел от 1 до n
expected = set(range(1, n + 1))
# проверка всех строк и всех столбцов
is_latin = True
# проверяем строки
for i in range(n):
    if set(matrix[i]) != expected:
        is_latin = False
        print(f"Строка {i + 1} не содержит все числа от 1 до {n}.")
        break
# проверяем столбцы
if is_latin:
    for j in range(n):
        column = {matrix[i][j] for i in range(n)}
        if column != expected:
            is_latin = False
            print(f"Столбец {j + 1} не содержит все числа от 1 до {n}.")
            break
if is_latin:
    print("Массив является латинским квадратом.")
else:
    print("Массив НЕ является латинским квадратом.")
