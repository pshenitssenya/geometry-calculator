import pytest
from task1 import run_length_encode
def test_run_length_encode_empty_returns_empty():
    data = []
    result = run_length_encode(data)
    assert result == []
def test_run_length_encode_no_repeats_returns_pairs_with_one():
    data = [1, 2, 3]
    result = run_length_encode(data)
    assert result == [(1, 1), (2, 1), (3, 1)]
def test_run_length_encode_repeats_returns_rle_format():
    data = [1, 1, 2, 3, 3, 3]
    result = run_length_encode(data)
    assert result == [(1, 2), (2, 1), (3, 3)]
def test_run_length_encode_strings_returns_correct_tuples():
    data = ["a", "a", "b"]
    result = run_length_encode(data)
    assert result == [("a", 2), ("b", 1)]
def test_run_length_encode_does_not_mutate_input():
    data = [1, 1, 2]
    original_copy = data.copy()
    run_length_encode(data)
    assert data == original_copy
