def longest_common_prefix(strings):
    if not strings:
        return ""
    first_word = strings[0]
    for i in range(len(first_word)):
        char = first_word[i]
        for word in strings[1:]:
            if i == len(word) or word[i] != char:
                return first_word[:i]
    return first_word



#refactor
def longest_common_prefix(strings):
    if not strings:
        return ""
    result = ""
    for chars in zip(*strings):
        if len(set(chars)) == 1:
            result += chars[0]
        else:
            break
    return result
